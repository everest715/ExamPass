.container { padding: 20rpx 0 120rpx; }

.form-card { padding: 0; }

.form-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-bottom: 2rpx solid #F0F0F0;
}
.form-row:last-child { border-bottom: none; }

.form-label { font-size: 30rpx; font-weight: bold; color: #333; width: 160rpx; }
.form-input { flex: 1; text-align: right; font-size: 30rpx; color: #FF6B35; }

picker { flex: 1; }
.picker-value {
  display: flex; align-items: center; justify-content: flex-end;
  font-size: 30rpx; color: #FF6B35; gap: 8rpx;
}
.picker-arrow { font-size: 24rpx; color: #CCC; }

.section-title { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; display: block; }

.module-item {
  border: 2rpx solid #F0F0F0; border-radius: 16rpx;
  margin-bottom: 24rpx; overflow: hidden;
}
.module-item .form-row { padding: 24rpx 32rpx; }
.module-remove {
  text-align: center; padding: 20rpx; font-size: 28rpx; color: #F44336;
  background: #FFF0F0; border-top: 2rpx solid #F0F0F0;
}

.add-module-btn {
  text-align: center; padding: 24rpx; font-size: 30rpx;
  color: #FF6B35; border: 2rpx dashed #FF6B35; border-radius: 16rpx;
}

.save-btn { margin: 40rpx 20rpx; }
