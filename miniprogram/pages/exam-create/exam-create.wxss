.container { padding: 20rpx 0 120rpx; }

.form-card { padding: 0; }

.form-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-bottom: 2rpx solid #F0F0F0;
}
.form-row:last-child { border-bottom: none; }

.form-label { font-size: 30rpx; font-weight: bold; color: #333; width: 160rpx; }
.form-input { flex: 1; text-align: right; font-size: 30rpx; color: #FF6B35; }

picker { flex: 1; }
.picker-value {
  display: flex; align-items: center; justify-content: flex-end;
  font-size: 30rpx; color: #FF6B35; gap: 8rpx;
}
.picker-arrow { font-size: 24rpx; color: #CCC; }

.section-title { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; display: block; }

.module-item {
  border: 2rpx solid #F0F0F0; border-radius: 16rpx;
  margin-bottom: 24rpx; overflow: hidden;
}
.module-item .form-row { padding: 24rpx 32rpx; }
.module-remove {
  text-align: center; padding: 20rpx; font-size: 28rpx; color: #F44336;
  background: #FFF0F0; border-top: 2rpx solid #F0F0F0;
}

.add-module-btn {
  text-align: center; padding: 24rpx; font-size: 30rpx;
  color: #FF6B35; border: 2rpx dashed #FF6B35; border-radius: 16rpx;
}

.save-btn { margin: 40rpx 20rpx; }

.chapter-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); display: flex; align-items: flex-end;
}
.chapter-popup {
  width: 100%; background: #FFF; border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh; display: flex; flex-direction: column;
}
.chapter-popup-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-bottom: 2rpx solid #F0F0F0;
}
.chapter-popup-title { font-size: 32rpx; font-weight: bold; }
.chapter-popup-actions { display: flex; gap: 32rpx; }
.chapter-popup-all { font-size: 28rpx; color: #999; }
.chapter-popup-done { font-size: 28rpx; color: #FF6B35; font-weight: bold; }
.chapter-list { max-height: 600rpx; }
.chapter-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; border-bottom: 2rpx solid #F8F8F8;
}
.chapter-check { width: 40rpx; height: 40rpx; border: 4rpx solid #DDD; border-radius: 8rpx; text-align: center; line-height: 40rpx; font-size: 28rpx; color: #FFF; }
.chapter-check.checked { background: #FF6B35; border-color: #FF6B35; }
