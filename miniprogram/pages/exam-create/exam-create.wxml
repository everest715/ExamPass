<view class="container">
  <!-- 基本信息 -->
  <view class="card form-card">
    <view class="form-row">
      <text class="form-label">考试名称</text>
      <input class="form-input" placeholder="如：期中复习" value="{{name}}" bindinput="onNameInput" maxlength="20" />
    </view>

    <view class="form-row">
      <text class="form-label">练习模式</text>
      <picker mode="selector" range="{{modes}}" value="{{modeIndex}}" bindchange="onModeChange">
        <view class="picker-value">{{modes[modeIndex]}}<text class="picker-arrow">▼</text></view>
      </picker>
    </view>

    <view class="form-row" wx:if="{{modeIndex === 1}}">
      <text class="form-label">计划天数</text>
      <picker mode="selector" range="{{dayOptions}}" value="{{dayIndex}}" bindchange="onDayChange">
        <view class="picker-value">{{dayOptions[dayIndex]}}<text class="picker-arrow">▼</text></view>
      </picker>
    </view>
  </view>

  <!-- 科目模块 -->
  <view class="card">
    <text class="section-title">科目模块</text>

    <view class="module-item" wx:for="{{modules}}" wx:key="index" wx:for-index="idx">
      <view class="form-row">
        <text class="form-label">年级</text>
        <picker mode="selector" range="{{grades}}" value="{{item.gradeIndex}}" bindchange="onGradeChange" data-idx="{{idx}}">
          <view class="picker-value">{{grades[item.gradeIndex] || '请选择'}}<text class="picker-arrow">▼</text></view>
        </picker>
      </view>

      <view class="form-row">
        <text class="form-label">科目</text>
        <picker mode="selector" range="{{item.subjects}}" value="{{item.subjectIndex}}" bindchange="onSubjectChange" data-idx="{{idx}}">
          <view class="picker-value">{{item.subjects[item.subjectIndex] || '请选择'}}<text class="picker-arrow">▼</text></view>
        </picker>
      </view>

      <view class="form-row">
        <text class="form-label">章节</text>
        <view class="picker-value" bindtap="onChapterTap" data-idx="{{idx}}">{{item.chapterDisplay || '全部章节'}}<text class="picker-arrow">▼</text></view>
      </view>

      <view class="module-remove" bindtap="onRemoveModule" data-idx="{{idx}}" wx:if="{{modules.length > 1}}">删除模块</view>
    </view>

    <view class="add-module-btn" bindtap="onAddModule">+ 添加模块</view>
  </view>

  <view class="btn-primary save-btn" bindtap="onSave">保存</view>
</view>

<!-- 章节选择弹窗 -->
<view class="chapter-mask" wx:if="{{chapterPickerVisible}}" bindtap="onChapterClose">
  <view class="chapter-popup" catchtap="onPopupTap">
    <view class="chapter-popup-header">
      <text class="chapter-popup-title">选择章节</text>
      <view class="chapter-popup-actions">
        <text class="chapter-popup-all" bindtap="onChapterSelectAll">全选/取消</text>
        <text class="chapter-popup-done" bindtap="onChapterDone">完成</text>
      </view>
    </view>
    <scroll-view scroll-y class="chapter-list">
      <view class="chapter-item" wx:for="{{chapterPickerOptions}}" wx:key="*this" data-name="{{item}}" bindtap="onChapterToggle">
        <text>{{item}}</text>
        <text class="chapter-check {{chapterPickerChecked[item] ? 'checked' : ''}}">{{chapterPickerChecked[item] ? '✓' : ''}}</text>
      </view>
    </scroll-view>
  </view>
</view>
