<!-- miniprogram/pages/select/select.wxml -->
<view class="container">
  <view class="card form-card">
    <view class="form-row">
      <text class="form-label">年级</text>
      <picker mode="selector" range="{{grades}}" value="{{selectedGradeIndex}}" bindchange="onGradeChange">
        <view class="picker-value">{{grades[selectedGradeIndex] || '请选择'}}<text class="picker-arrow">▼</text></view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">科目</text>
      <picker mode="selector" range="{{subjects}}" value="{{selectedSubjectIndex}}" bindchange="onSubjectChange">
        <view class="picker-value">{{subjects[selectedSubjectIndex] || '请选择'}}<text class="picker-arrow">▼</text></view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">章节</text>
      <picker mode="selector" range="{{chapters}}" value="{{selectedChapterIndex}}" bindchange="onChapterChange">
        <view class="picker-value">{{chapters[selectedChapterIndex] || '请选择'}}<text class="picker-arrow">▼</text></view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">模式</text>
      <picker mode="selector" range="{{modes}}" value="{{selectedModeIndex}}" bindchange="onModeChange">
        <view class="picker-value">{{modes[selectedModeIndex]}}<text class="picker-arrow">▼</text></view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">题量</text>
      <picker mode="selector" range="{{counts}}" value="{{selectedCountIndex}}" bindchange="onCountChange">
        <view class="picker-value">{{counts[selectedCountIndex]}}<text class="picker-arrow">▼</text></view>
      </picker>
    </view>
  </view>

  <view class="btn-primary start-btn" bindtap="startPractice">开始练习</view>
</view>
