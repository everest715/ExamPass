.container { padding: 20rpx 0; }

.section-title { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; display: block; }

.form-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 0; border-bottom: 2rpx solid #F0F0F0;
}
.form-row:last-child { border-bottom: none; }

.form-label { font-size: 30rpx; font-weight: bold; color: #333; width: 180rpx; }

.form-input {
  flex: 1; text-align: right; font-size: 30rpx; color: #FF6B35;
}

picker { flex: 1; }
.picker-value {
  display: flex; align-items: center; justify-content: flex-end;
  font-size: 30rpx; color: #FF6B35; gap: 8rpx;
}
.picker-arrow { font-size: 24rpx; color: #CCC; }

.switch-row { padding: 20rpx 0; }

.about-card { text-align: center; padding: 48rpx 32rpx; }
.about-title { font-size: 32rpx; font-weight: bold; color: #333; display: block; margin-bottom: 12rpx; }
.about-version { font-size: 24rpx; color: #999; }

.btn-danger {
  background-color: #FFF0F0; color: #F44336;
  border-radius: 16rpx; padding: 24rpx; text-align: center;
  font-size: 30rpx; font-weight: bold;
}
